# Public defaults. Local overrides belong in the ignored .env file.
PRESET=conservative
IMAGE=z100l-strata:local
CONTAINER=z100l-strata
DTK_DIR=/opt/dtk
HYHAL_DIR=/opt/hyhal
GPU_ID=0
PUBLISH_HOST=127.0.0.1
PORT=18080
BUILD_JOBS=4
PACK_JOBS=4
CHECK_MODEL_HASH=1
STOP_TIMEOUT=180
RESTART_POLICY=no
DOCKER_APPARMOR=z100l-strata
DOCKER_NETWORK=bridge
AMDGPU_TARGETS=gfx906
SHM_SIZE=2g
