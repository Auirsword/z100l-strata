@@ -0,0 +1,298 @@
+#include "strata/core/conversation_l3.hpp"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <new>
+#include <system_error>
+
+namespace strata::core {
+
+namespace {
+
+// The sidecar holds only what find_best() matches on, so a scan never opens the (possibly huge) session file:
+// magic "STL3IDX\2", then u8 cvec, the live key, u64 checkpoint count and every checkpoint key; a key is u64 token
+// count, u64 ids hash, u64 image count and, per image, i64 start + u64 hash.  Host-endianness on purpose: the
+// archive is written and read by the same engine build.  Version 1 indexed only the live state; its sidecars are
+// refused (the live token list can end past the client's rendered history, so the checkpoints are what matches).
+const char kSidecarMagic[8] = {'S', 'T', 'L', '3', 'I', 'D', 'X', 2};
+const uint64_t kSidecarMaxImages = 1 << 20, kSidecarMaxCheckpoints = 1 << 16;
+
+uint64_t key_hash(const ConversationCheckpoint& c) {
+    return session_hash64(c.ids.data(), c.ids.size() * sizeof(int32_t), 0);
+}
+
+bool sidecar_put(std::ofstream& f, const void* p, size_t n) {
+    f.write((const char*) p, (std::streamsize) n);
+    return (bool) f;
+}
+
+bool sidecar_get(std::ifstream& f, void* p, size_t n) {
+    f.read((char*) p, (std::streamsize) n);
+    return (bool) f;
+}
+
+bool sidecar_put_key(std::ofstream& f, const ConversationL3Store::Key& k) {
+    const uint64_t n_imgs = k.imgs.size();
+    if (!sidecar_put(f, &k.tokens, 8) || !sidecar_put(f, &k.ids_hash, 8) || !sidecar_put(f, &n_imgs, 8))
+        return false;
+    for (const auto& img : k.imgs)
+        if (!sidecar_put(f, &img.start, 8) || !sidecar_put(f, &img.hash, 8)) return false;
+    return true;
+}
+
+bool sidecar_get_key(std::ifstream& f, ConversationL3Store::Key& k) {
+    uint64_t n_imgs = 0;
+    if (!sidecar_get(f, &k.tokens, 8) || !sidecar_get(f, &k.ids_hash, 8) || !sidecar_get(f, &n_imgs, 8) ||
+        n_imgs > kSidecarMaxImages)
+        return false;
+    k.imgs.clear();
+    k.imgs.reserve((size_t) n_imgs);
+    for (uint64_t i = 0; i < n_imgs; ++i) {
+        ConversationImageKey img;
+        if (!sidecar_get(f, &img.start, 8) || !sidecar_get(f, &img.hash, 8)) return false;
+        k.imgs.push_back(img);
+    }
+    return true;
+}
+
+} // namespace
+
+ConversationL3Store::ConversationL3Store(std::string dir, uint64_t budget_bytes, IdentityFn identity,
+                                         LimitsFn limits, LogFn log)
+    : dir_(std::move(dir)), budget_(budget_bytes), identity_(std::move(identity)), limits_(std::move(limits)),
+      log_(std::move(log)) {
+    if (dir_.empty()) return;
+    try {
+        scan();
+    } catch (const std::exception& e) {
+        // a scan failure must not keep the engine from starting: the archive just starts empty
+        say(std::string("scan of ") + dir_ + " failed: " + e.what());
+        entries_.clear();
+        bytes_ = 0;
+    }
+}
+
+void ConversationL3Store::scan() {
+    namespace fs = std::filesystem;
+    std::error_code ec;
+    fs::create_directories(dir_, ec);
+    ec.clear();
+    std::vector<std::pair<uint64_t, std::string>> found;   // (mtime ticks, path), so the LRU order survives a restart
+    fs::directory_iterator it(dir_, fs::directory_options::skip_permission_denied, ec), end;
+    while (!ec && it != end) {
+        const std::string name = it->path().filename().string();
+        if (name.rfind("strata-l3-", 0) == 0 && name.size() > 8 &&
+            name.compare(name.size() - 8, 8, ".session") == 0) {
+            std::error_code ec2;
+            const auto mtime = it->last_write_time(ec2);
+            if (!ec2) found.push_back({(uint64_t) mtime.time_since_epoch().count(), it->path().string()});
+        }
+        it.increment(ec);
+    }
+    std::sort(found.begin(), found.end());
+    for (const auto& f : found) {
+        Entry e;
+        if (!read_sidecar(f.second, e)) {
+            say("skipped " + f.second + " (no readable sidecar)");
+            continue;
+        }
+        std::error_code ec2;
+        const uint64_t sz = fs::file_size(f.second, ec2);
+        if (ec2) {
+            say("skipped " + f.second + " (cannot stat)");
+            continue;
+        }
+        e.path = f.second;
+        e.bytes = sz;
+        e.lru = ++clock_;
+        e.generation = generation_;
+        bytes_ += e.bytes;
+        entries_.push_back(std::move(e));
+    }
+    serial_ = entries_.size();
+    while (bytes_ > budget_ && !entries_.empty()) evict_lru();   // the budget shrank since these were written
+}
+
+bool ConversationL3Store::write_sidecar(const Entry& e, std::string& error) const {
+    namespace fs = std::filesystem;
+    const std::string side = sidecar_path(e.path);
+    const std::string tmp = side + ".tmp";
+    {
+        std::ofstream f(tmp, std::ios::binary | std::ios::trunc);
+        if (!f) { error = "cannot open " + tmp; return false; }
+        const uint8_t cv = e.cvec ? 1 : 0;
+        const uint64_t n_checks = e.checkpoints.size();
+        bool ok = sidecar_put(f, kSidecarMagic, 8) && sidecar_put(f, &cv, 1) && sidecar_put_key(f, e.live) &&
+                  sidecar_put(f, &n_checks, 8);
+        for (const Key& k : e.checkpoints) ok = ok && sidecar_put_key(f, k);
+        if (!ok) { error = "cannot write " + tmp; return false; }
+    }
+    std::error_code ec;
+    fs::rename(tmp, side, ec);
+    if (ec) {
+        error = "cannot rename the sidecar over " + side + ": " + ec.message();
+        fs::remove(tmp, ec);
+        return false;
+    }
+    return true;
+}
+
+bool ConversationL3Store::read_sidecar(const std::string& session_path, Entry& e) const {
+    std::ifstream f(sidecar_path(session_path), std::ios::binary);
+    if (!f) return false;
+    char magic[8];
+    uint8_t cv = 0;
+    uint64_t n_checks = 0;
+    if (!sidecar_get(f, magic, 8) || std::memcmp(magic, kSidecarMagic, 8) != 0) return false;
+    if (!sidecar_get(f, &cv, 1) || !sidecar_get_key(f, e.live) || !sidecar_get(f, &n_checks, 8) ||
+        n_checks > kSidecarMaxCheckpoints)
+        return false;
+    e.cvec = cv != 0;
+    e.checkpoints.clear();
+    e.checkpoints.reserve((size_t) n_checks);
+    for (uint64_t i = 0; i < n_checks; ++i) {
+        Key k;
+        if (!sidecar_get_key(f, k)) return false;
+        e.checkpoints.push_back(std::move(k));
+    }
+    char extra;
+    return !f.read(&extra, 1);   // a longer sidecar is not one this engine wrote
+}
+
+void ConversationL3Store::evict_lru() {
+    size_t oldest = 0;
+    for (size_t i = 1; i < entries_.size(); ++i)
+        if (entries_[i].lru < entries_[oldest].lru) oldest = i;
+    const Entry e = entries_[oldest];
+    std::error_code ec;
+    std::filesystem::remove(e.path, ec);
+    std::filesystem::remove(sidecar_path(e.path), ec);
+    bytes_ -= e.bytes;
+    entries_.erase(entries_.begin() + (std::ptrdiff_t) oldest);
+    say("evicted " + e.path + " (over budget)");
+}
+
+bool ConversationL3Store::archive(SavedConversation&& image) noexcept {
+    try {
+        if (!enabled()) return false;
+        if (!image.stage_images.empty()) {
+            say("not archived: a layer-split image (a session file holds one GPU's image)");
+            return false;
+        }
+        Entry e;
+        e.live.tokens = image.live.ids.size();
+        if (e.live.tokens == 0) return false;
+        e.live.ids_hash = key_hash(image.live);
+        e.live.imgs = image.live.imgs;
+        e.cvec = image.cvec;
+        e.checkpoints.reserve(image.checkpoints.size());
+        for (const auto& c : image.checkpoints) {
+            if (c.ids.empty()) continue;
+            Key k;
+            k.tokens = c.ids.size();
+            k.ids_hash = key_hash(c);
+            k.imgs = c.imgs;
+            e.checkpoints.push_back(std::move(k));
+        }
+        for (Entry& x : entries_) {
+            // the same state is already on disk (a restore -> park -> evict round of a conversation that did not
+            // advance): refresh it instead of writing the same bytes again
+            if (x.generation == generation_ && x.cvec == e.cvec && x.live.tokens == e.live.tokens &&
+                x.live.ids_hash == e.live.ids_hash && x.live.imgs == e.live.imgs) {
+                x.lru = ++clock_;
+                return true;
+            }
+        }
+        if (image.bytes() > budget_) {
+            say("not archived: the image exceeds the whole disk budget");
+            return false;
+        }
+        SessionFileIdentity id;
+        std::string error;
+        if (!identity_ || !identity_(id, error)) {
+            say("not archived: identity: " + error);
+            return false;
+        }
+        char name[160];
+        std::snprintf(name, sizeof name, "strata-l3-g%" PRIu64 "-%016" PRIx64 "-t%" PRIu64 "-s%" PRIu64 ".session",
+                      generation_, e.live.ids_hash, e.live.tokens, ++serial_);
+        e.path = dir_ + "/" + name;
+        size_t bytes = 0;
+        SessionStatus st;
+        if (!session_file_write(e.path, image, id, bytes, error, write_options, &st)) {
+            say("not archived: " + error);
+            std::error_code ec;
+            std::filesystem::remove(e.path, ec);   // a published-but-unflushed file too: it never joins the index
+            return false;
+        }
+        e.bytes = bytes;
+        e.lru = ++clock_;
+        e.generation = generation_;
+        if (!write_sidecar(e, error)) {
+            say("not archived: " + error);
+            std::error_code ec;
+            std::filesystem::remove(e.path, ec);
+            std::filesystem::remove(sidecar_path(e.path), ec);
+            return false;
+        }
+        const uint64_t mine = e.lru;
+        bytes_ += e.bytes;
+        say("archived " + std::to_string(e.live.tokens) + " tokens (" +
+            std::to_string(e.checkpoints.size()) + " checkpoints), " + std::to_string(bytes) + " bytes to " + e.path);
+        entries_.push_back(std::move(e));
+        while (bytes_ > budget_ && !entries_.empty()) evict_lru();   // the new file (the highest lru) goes last
+        for (const Entry& x : entries_)
+            if (x.lru == mine) return true;
+        return false;   // the budget could not hold even this one file (it went again)
+    } catch (const std::bad_alloc&) {
+        say("not archived: out of memory");
+        return false;
+    } catch (const std::exception& ex) {
+        say(std::string("not archived: ") + ex.what());
+        return false;
+    }
+}
+
+bool ConversationL3Store::load(const std::string& path, SavedConversation& image, std::string& error) noexcept {
+    try {
+        SessionFileIdentity id;
+        if (!identity_ || !identity_(id, error)) return false;
+        SessionReadLimits limits;
+        if (limits_ && !limits_(limits, error)) return false;
+        size_t bytes = 0;
+        SessionStatus st;
+        if (!session_file_read(path, id, image, bytes, error, limits, &st)) return false;
+        for (Entry& e : entries_)
+            if (e.path == path) { e.lru = ++clock_; break; }
+        return true;
+    } catch (const std::bad_alloc&) {
+        error = "out of memory while reading an archived conversation";
+        return false;
+    } catch (const std::exception& ex) {
+        error = ex.what();
+        return false;
+    }
+}
+
+void ConversationL3Store::bump_generation() noexcept {
+    try {
+        for (const Entry& e : entries_) {
+            std::error_code ec;
+            std::filesystem::remove(e.path, ec);
+            std::filesystem::remove(sidecar_path(e.path), ec);
+        }
+        const size_t n = entries_.size();
+        entries_.clear();
+        bytes_ = 0;
+        ++generation_;
+        if (n) say("invalidated " + std::to_string(n) + " archived conversation(s) after non-finite logits (#879)");
+    } catch (...) {
+        // invalidation is best-effort; a leftover file is out of the index and never matched again
+    }
+}
+
+} // namespace strata::core
