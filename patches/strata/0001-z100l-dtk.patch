+"""serve/test_admit_affinity.py - STRATA_ADMIT_AFFINITY: a new request on a slot's own topic takes the control
+lines before one on a new topic (StrataEngine._take_control / _admit_affinity; no process, no GPU).
+
+    python -m unittest serve.test_admit_affinity -v
+"""
+from __future__ import annotations
+
+import sys
+import threading
+import time
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import serve.server as server  # noqa: E402
+from serve.server import StrataEngine, prompt_sig, sig_match  # noqa: E402
+
+HEAD = list(range(24))                      # the shared chat-template head, not part of a signature
+BODY_A = list(range(100, 200))              # topic A's vocabulary
+BODY_B = list(range(1000, 1100))            # topic B's (disjoint)
+SIG_A = prompt_sig(HEAD + BODY_A)
+SIG_B = prompt_sig(HEAD + BODY_B)
+
+
+def engine_without_process(n=2):
+    """A StrataEngine with the admission state of a started one and no process: alive() is `e.up`."""
+    e = StrataEngine("missing-executable", [], lazy=True)
+    e.batch = n
+    e.slot_busy = [False] * n
+    e.slot_claims, e.slot_releasing, e._orphan_seen = set(), set(), {}
+    e.slot_cv = threading.Condition()
+    e.waiting, e.admitting, e.wait_lens, e.ctl_epoch = 0, 0, [], 0
+    e.slot_live = [None] * n
+    e.ctl = threading.Lock()
+    e.gen = 1
+    e.up = True
+    e.alive = lambda: e.up
+    return e
+
+
+def live(sig):
+    """A slot_live row as generate_batched writes it: only the signature matters here."""
+    return {"slot": 0, "request_id": 1, "state": "decoding", "prompt_tokens": 100, "prompt_read": 100,
+            "generated": 10, "started": time.time(), "first_token": time.time(), "sig": sig}
+
+
+class AdmitAffinityTest(unittest.TestCase):
+    def setUp(self):
+        self.e = engine_without_process(16)
+        self.order, self.cancels = [], []
+        self.order_lock = threading.Lock()
+
+    def tearDown(self):
+        for c in self.cancels:
+            c.set()
+
+    def take(self, name, plen, **kw):
+        """A request waiting for the control lines; once it has them it notes its name and gives them back."""
+        c = threading.Event()
+        self.cancels.append(c)
+
+        def go():
+            gen = self.e._take_control(c, plen, **kw)
+            try:
+                while True:
+                    next(gen)
+            except StopIteration as s:
+                if s.value:
+                    with self.order_lock:
+                        self.order.append(name)
+                    time.sleep(0.05)                # its read
+                    self.e.ctl.release()
+        threading.Thread(target=go, daemon=True).start()
+
+    def until(self, cond, s=5.0):
+        end = time.time() + s
+        while time.time() < end and not cond():
+            time.sleep(0.01)
+        self.assertTrue(cond())
+
+    def queue(self, *reqs):
+        """While a long read holds the control lines, the requests arrive in this order; then the read ends."""
+        self.assertTrue(self.e.ctl.acquire(timeout=1))
+        for name, plen, kw in reqs:
+            self.take(name, plen, **kw)
+            time.sleep(0.02)                        # (distinct arrival times)
+        self.until(lambda: self.e.waiting == len(reqs))
+        self.e.ctl.release()
+        self.until(lambda: len(self.order) == len(reqs), s=15.0)
+        return self.order
+
+    def test_same_topic_goes_first(self):
+        """A slot decodes topic A; a later A request passes an earlier B request."""
+        self.e.slot_live[0] = live(SIG_A)
+        with mock.patch.object(server, "ADMIT_AFFINITY", True), \
+                mock.patch.object(server, "ADMIT_MAX_WAIT_S", 60.0):
+            order = self.queue(("b", 4000, {"new": True, "sig": SIG_B}),
+                               ("a2", 4000, {"new": True, "sig": SIG_A}))
+        self.assertEqual(order, ["a2", "b"])
+
+    def test_fifo_when_slots_empty_or_signatureless(self):
+        """Nothing in the slots (or nothing with a signature): arrival order, as before."""
+        with mock.patch.object(server, "ADMIT_AFFINITY", True), \
+                mock.patch.object(server, "ADMIT_MAX_WAIT_S", 60.0):
+            order = self.queue(("b", 4000, {"new": True, "sig": SIG_B}),
+                               ("a", 4000, {"new": True, "sig": SIG_A}))
+        self.assertEqual(order, ["b", "a"])
+
+    def test_a_request_that_waited_too_long_goes_first(self):
+        """Fairness: past STRATA_ADMIT_MAX_WAIT_S a mismatched request counts as matching."""
+        self.e.slot_live[0] = live(SIG_A)
+        with mock.patch.object(server, "ADMIT_AFFINITY", True), \
+                mock.patch.object(server, "ADMIT_MAX_WAIT_S", 0.2):
+            self.assertTrue(self.e.ctl.acquire(timeout=1))
+            self.take("b", 4000, new=True, sig=SIG_B)
+            self.until(lambda: self.e.waiting == 1)
+            time.sleep(0.4)                         # past STRATA_ADMIT_MAX_WAIT_S
+            self.take("a2", 4000, new=True, sig=SIG_A)
+            self.until(lambda: self.e.waiting == 2)
+            self.e.ctl.release()
+            self.until(lambda: len(self.order) == 2, s=15.0)
+        self.assertEqual(self.order, ["b", "a2"])
+
+    def test_off_by_default(self):
+        self.assertEqual(server.ADMIT_AFFINITY if "STRATA_ADMIT_AFFINITY" not in __import__("os").environ
+                         else False, False)
+        self.e.slot_live[0] = live(SIG_A)
+        with mock.patch.object(server, "ADMIT_AFFINITY", False):
+            order = self.queue(("b", 4000, {"new": True, "sig": SIG_B}),
+                               ("a2", 4000, {"new": True, "sig": SIG_A}))
+        self.assertEqual(sorted(order), ["a2", "b"])            # both get their turn, in any order
+
+    def test_a_continuation_is_not_held_back(self):
+        """A request already admitted once (new=False: promoted from the solo path) is not part of the order."""
+        self.e.slot_live[0] = live(SIG_A)
+        with mock.patch.object(server, "ADMIT_AFFINITY", True), \
+                mock.patch.object(server, "ADMIT_MAX_WAIT_S", 60.0):
+            order = self.queue(("b", 4000, {"new": True, "sig": SIG_B}),
+                               ("continuation", 9000, {"sig": SIG_B}))
+        self.assertEqual(sorted(order), ["b", "continuation"])
+
+    def test_signature_basics(self):
+        self.assertIsNone(prompt_sig(list(range(10))))                    # no body to speak of
+        self.assertEqual(sig_match(SIG_A, prompt_sig(HEAD + BODY_A)), 1.0)
+        self.assertEqual(sig_match(SIG_A, SIG_B), 0.0)
+        self.assertEqual(sig_match(None, SIG_A), 0.0)
+        headless = prompt_sig(HEAD + BODY_A[:50])
+        self.assertGreater(sig_match(headless, SIG_A), 0.3)               # a shorter same-topic read still matches
+
+
+if __name__ == "__main__":
+    unittest.main()
