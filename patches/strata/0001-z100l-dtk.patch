diff --git a/include/strata/core/conversation_l3.hpp b/include/strata/core/conversation_l3.hpp
new file mode 100644
index 0000000..7eef680
--- /dev/null
+++ b/include/strata/core/conversation_l3.hpp
@@ -0,0 +1,137 @@
+// SSD persistence for parked conversations (the L3 archive): the RAM ConversationCache hands every conversation it
+// evicts to a ConversationL3Store, which writes it as an ordinary session file (conversation_file.hpp - the same
+// format as SAVE) plus a small index sidecar; a RAM-cache miss asks find_best() for the longest archived prefix of
+// the new prompt and load()s it back into the RAM cache.  Pure host code, batch-safe: it only ever moves
+// SavedConversation images.  Files from an earlier run of the engine are picked up at construction, so a restarted
+// engine keeps its archive.  bump_generation() voids the whole archive after non-finite logits (#879): an image
+// captured before the flush may carry the poison, so every file goes, not just the ones written since.
+#pragma once
+
+#include "strata/core/conversation_file.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace strata::core {
+
+class ConversationL3Store {
+public:
+    // What a write/read binds the file to (the engine's model and config fingerprints) and the bounds a read
+    // checks before it allocates - the engine fills both from its runtime, as for SAVE/RESTORE.
+    using IdentityFn = std::function<bool(SessionFileIdentity& id, std::string& error)>;
+    using LimitsFn = std::function<bool(SessionReadLimits& limits, std::string& error)>;
+    using LogFn = std::function<void(const std::string& message)>;
+
+    // One matchable prefix of an archived conversation: a token count, the 64-bit hash of the tokens (as int32_t
+    // bytes), and the images below that length.  Public: the sidecar helpers read and write keys.
+    struct Key {
+        uint64_t tokens = 0, ids_hash = 0;
+        std::vector<ConversationImageKey> imgs;
+    };
+
+    // Scans `dir` (created when missing): every complete strata-l3-*.session with a readable sidecar joins the
+    // index, least recently modified first; an over-budget archive loses its least recently used files at once.
+    ConversationL3Store(std::string dir, uint64_t budget_bytes, IdentityFn identity, LimitsFn limits, LogFn log);
+
+    bool enabled() const { return !dir_.empty(); }
+    size_t size() const { return entries_.size(); }
+    uint64_t bytes() const { return bytes_; }
+    uint64_t generation() const { return generation_; }
+
+    // Extra knobs of every archive write (the progress/phase hooks keep the engine's watchdog informed; the
+    // session-file defaults of the other fields apply).  Set by the caller once, before the first archive().
+    SessionWriteOptions write_options;
+
+    // The cache's evicted image becomes dir_/strata-l3-<...>.session (sidecar <...>.session.idx).  Over budget,
+    // the least recently used archived files go first (unlink).  False - nothing indexed - on any I/O or identity
+    // failure, for a layer-split image (stage_images: the session format holds one GPU's image), for an empty live
+    // state, and for an image bigger than the whole budget.  An image already archived (same live length, ids
+    // hash, images and cvec) only refreshes the entry's LRU stamp: the bytes on disk are that same state.  Never
+    // throws; the engine keeps serving when the disk archive fails.
+    bool archive(SavedConversation&& image) noexcept;
+
+    // The longest archived prefix of (prompt, images) with this cvec, over each entry's live state AND its
+    // checkpoints - the same candidates the RAM cache's best() considers.  The checkpoints matter: the live token
+    // list can end past the client's rendered history (a speculative window commits its bonus token without
+    // reporting it), so the client-reconstructable prefix is usually the turn checkpoint.  The acceptance rule is
+    // the RAM cache's conversation_prefix(), with the saved token list checked by a 64-bit hash kept in the
+    // sidecar (the caller re-checks the loaded image's tokens exactly before using it).  The hash is over the
+    // tokens as int32_t (the saved representation), whatever integer type the prompt buffer uses.  Ties prefer
+    // the most recently used entry.  0 when nothing matches; on a hit `path` is the file to load().
+    template<class Token>
+    int64_t find_best(const std::vector<Token>& prompt, const std::vector<ConversationImageKey>& images,
+                      bool cvec, std::string& path) const {
+        static_assert(std::is_integral<Token>::value, "token ids are integers");
+        int64_t best_tokens = 0;
+        uint64_t best_lru = 0;
+        for (const Entry& e : entries_) {
+            if (e.cvec != cvec || e.generation != generation_) continue;
+            int64_t n = match(e.live, prompt, images);
+            for (const Key& k : e.checkpoints) n = std::max(n, match(k, prompt, images));
+            if (n > best_tokens || (n == best_tokens && n > 0 && e.lru > best_lru)) {
+                best_tokens = n;
+                best_lru = e.lru;
+                path = e.path;
+            }
+        }
+        return best_tokens;
+    }
+
+    // Reads an archived file back (session_file_read: identity, bounded parse, payload hash).  A hit refreshes the
+    // entry's LRU stamp.  False with `error` on any failure; `image` is then untouched.  Never throws.
+    bool load(const std::string& path, SavedConversation& image, std::string& error) noexcept;
+
+    // #879: everything archived so far may hold the poison the flush just dropped from RAM - delete every file and
+    // start a new generation.  A file that cannot be removed stays on disk but is out of the index.
+    void bump_generation() noexcept;
+
+private:
+    struct Entry {
+        std::string path;   // the .session file; the sidecar is path + ".idx"
+        uint64_t bytes = 0, lru = 0, generation = 0;
+        Key live;
+        std::vector<Key> checkpoints;
+        bool cvec = false;
+    };
+
+    // conversation_prefix() with the token list checked by its hash: the saved ids must be a proper prefix of the
+    // prompt (the last prompt token starts the next verify window), with the same images below them.
+    template<class Token>
+    int64_t match(const Key& k, const std::vector<Token>& prompt,
+                  const std::vector<ConversationImageKey>& images) const {
+        const size_t n = (size_t) k.tokens;
+        if (n == 0 || n >= prompt.size()) return 0;
+        SessionHasher h(0);   // streaming and one-shot agree: the archive hashed the int32_t vector's bytes
+        for (size_t i = 0; i < n; ++i) {
+            const int32_t t = (int32_t) prompt[i];
+            h.update(&t, sizeof t);
+        }
+        if (h.digest() != k.ids_hash) return 0;
+        size_t j = 0;
+        for (const auto& image : images) {
+            if (image.start >= (int64_t) n) continue;
+            if (j == k.imgs.size() || !(k.imgs[j++] == image)) return 0;
+        }
+        return j == k.imgs.size() ? (int64_t) n : 0;
+    }
+
+    void scan();
+    bool write_sidecar(const Entry& e, std::string& error) const;
+    bool read_sidecar(const std::string& session_path, Entry& e) const;
+    void evict_lru();   // removes the lowest-lru entry and its files
+    static std::string sidecar_path(const std::string& path) { return path + ".idx"; }
+    void say(const std::string& message) const { if (log_) log_(message); }
+
+    std::string dir_;
+    uint64_t budget_ = 0, bytes_ = 0, clock_ = 0, generation_ = 0, serial_ = 0;
+    IdentityFn identity_;
+    LimitsFn limits_;
+    LogFn log_;
+    std::vector<Entry> entries_;   // arbitrary order; `lru` is the recency stamp
+};
+
+} // namespace strata::core
